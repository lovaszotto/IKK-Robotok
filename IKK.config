# FORMAI ELLENORZO RENDSZER - Konfiguracios Fajl
# ===================================================
# Ez a fajl tartalmazza a rendszer alapbeallitasait
# Modositsd ezeket az ertekeket igenyeid szerint

# Mire nevezzük át az input fájlokat
rename_prefix=NONE

# Bementi konyvtar - ide keruljenek a feldolgozando DOCX fajlok
input_folder=c:/tmp/keziratok_teszteleshez/
#input_folder=x:/M05_tananyag_ellenorzes_automatizalas/tananyag_kezirat_ellenorzes_robot/Keziratok_2026_01_09/5/

# Kimeneti konyvtar - ide keszulnek az Excel jelentesek
output_folder=c:\tmp

# Web ellenőrzés futtatásay
web_check_enabled=False



